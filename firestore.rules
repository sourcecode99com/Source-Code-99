rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isPublished(data) {
      return data.status == 'published';
    }

    // Articles collection
    match /articles/{articleId} {
      // Anyone can read published articles
      // Authenticated users can read all (including drafts)
      allow read: if isAuthenticated() || isPublished(resource.data);
      
      // Only authenticated users can create/update/delete
      allow create: if isAuthenticated() && isValidArticle(request.resource.data);
      allow update: if isAuthenticated() && isValidArticle(request.resource.data);
      allow delete: if isAuthenticated();
    }

    function isValidArticle(data) {
      return data.title is string && data.title.size() > 0 &&
             data.slug is string && data.slug.size() > 0 &&
             data.content is string &&
             data.status in ['draft', 'published'];
    }

    // Schedules collection
    match /schedules/{scheduleId} {
      // Only authenticated users can access schedules
      allow read, write: if isAuthenticated();
    }
  }
}
