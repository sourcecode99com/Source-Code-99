# Gemini API Key for AI Assistant
# Get your own key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK credentials (server-side only).
# Used exclusively by middleware.ts to prerender /blog/:slug pages for
# search engine and link-preview crawlers (Googlebot, Bingbot, etc.), by
# reading Firestore directly with a service account instead of the
# restricted client Web API key.
#
# To generate these values:
#   1. Firebase Console > Project Settings > Service Accounts
#   2. Click "Generate new private key" and download the JSON file
#   3. Copy "client_email" and "private_key" from that JSON into the
#      variables below (locally), or into your Vercel Project's
#      Environment Variables (in production) - never commit the real
#      values to source control.
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
